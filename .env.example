# Copy to .env  (all optional - the MVP runs with none of these)
PORT=3000
DB_PATH=data/saathi.db
SESSION_SECRET=change-me
# Pin the clock so the demo always shows a mid-morning shop (ISO, local time)
# SAATHI_NOW=2026-09-22T11:30:00

# --- action executor ----------------------------------------------------------
# Rails are mocks by default. Point any action at a real service (JSON in/out):
# RAIL_LAUNCH_OFFER_URL=https://partner.example/offers
# RAIL_WINBACK_URL=  RAIL_REORDER_URL=  RAIL_GST_INVOICE_URL=  RAIL_LOAN_URL=  RAIL_REVERT_URL=
# RAIL_AUTH=Bearer xxx
# EXEC_DELAY_MS=900

# --- WhatsApp Cloud API (inbound webhook: POST/GET /api/channels/whatsapp) ------
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=saathi-verify
# BRIEF_HOUR=8

# --- Cognee (Merchant Brain memory / knowledge graph) ------------------------
# COGNEE_URL=http://localhost:8000
# COGNEE_TOKEN=

# --- LLM tiering (rules -> small -> large). Leave empty for rules + templates ---
# ANTHROPIC_API_KEY=
# LLM_MODEL_SMALL=claude-haiku-4-5-20251001
# LLM_MODEL_LARGE=claude-sonnet-5

# --- guardrails ----------------------------------------------------------------
MAX_OFFER_SPEND=500
MAX_WINBACK_RECIPIENTS=500

